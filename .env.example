# Copy to .env and adjust. The real .env never goes into the repository.

# Local port on 127.0.0.1 under which the reverse proxy reaches the app.
MAKERHUB_PORT=8000

# Optional: run a published version instead of building locally. Replace OWNER/REPO and the tag.
# MAKERHUB_IMAGE=ghcr.io/OWNER/REPO:TAG

# Interface language: de (default) or en. Unknown values fall back to de.
# MAKERHUB_LANGUAGE=de

# Origins that may embed the app in an iframe (e.g. the Bambuddy sidebar), comma-separated,
# like https://bambuddy.example.com (no wildcards, no paths). Empty = nobody may embed.
# An invalid value stops the app from starting.
# MAKERHUB_EMBED_ORIGINS=

# Folder for the database (makerhub3d.db). In the container this is the /data volume;
# only change it for running the app outside the container. Default outside: ./data
# MAKERHUB_DATA_DIR=/data

# The login cookie is only sent over HTTPS (through the reverse proxy). Set true only if you
# open the app in your own home network without HTTPS; the login then travels unencrypted.
# Opening it directly via http://localhost usually works without this setting (Chrome, Firefox).
# Allowed values: true or false. An invalid value stops the app from starting.
# MAKERHUB_INSECURE_COOKIES=false

# Time zone in which times are shown (e.g. in the log); stored are UTC times.
# An invalid value stops the app from starting.
# MAKERHUB_TIMEZONE=Europe/Berlin

# Key for the two-factor login (codes from an app). Without it, two-factor login cannot be set up.
# Create it once with: openssl rand -hex 32   (at least 32 characters, no spaces)
# Keep a copy in a safe place: if it is lost, everybody has to set up two-factor login again.
# An invalid value, or a key that does not match the stored setups, stops the app from starting.
# MAKERHUB_2FA_KEY=
