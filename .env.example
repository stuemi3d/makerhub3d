# Copy to .env and adjust. The real .env never goes into the repository.

# Local port on 127.0.0.1 under which the reverse proxy reaches the app.
MAKERHUB_PORT=8000

# Optional: run a published version instead of building locally. Replace OWNER/REPO and the tag.
# MAKERHUB_IMAGE=ghcr.io/OWNER/REPO:TAG

# Interface language: de (default) or en. Unknown values fall back to de.
# MAKERHUB_LANGUAGE=de

# Origins that may embed the app in an iframe (e.g. the Bambuddy sidebar), comma-separated,
# like https://bambuddy.example.com (no wildcards, no paths). Empty = nobody may embed.
# An invalid value stops the app from starting.
# MAKERHUB_EMBED_ORIGINS=

# Folder for the database (makerhub3d.db). In the container this is the /data volume;
# only change it for running the app outside the container. Default outside: ./data
# MAKERHUB_DATA_DIR=/data
